code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec4 effect_color : source_color;
uniform vec2 Speed;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D tex_frg_4;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = effect_color;


// Input:9
	float n_out9p0 = TIME;


// Vector2Parameter:10
	vec2 n_out10p0 = Speed;


// VectorOp:8
	vec2 n_out8p0 = vec2(n_out9p0) * n_out10p0;


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = n_out8p0 * n_in7p1 + UV;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out7p0);
	float n_out3p3 = n_out3p0.b;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);
	float n_out4p3 = n_out4p0.b;


// FloatOp:5
	float n_out5p0 = n_out3p3 - n_out4p3;


// Clamp:6
	float n_in6p1 = 0.00000;
	float n_in6p2 = 1.00000;
	float n_out6p0 = clamp(n_out5p0, n_in6p1, n_in6p2);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out6p0;


}
