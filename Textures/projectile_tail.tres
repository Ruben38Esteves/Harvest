	float n_out2p1 = n_out2p0.r;


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out8p4) * vec2(n_out2p1);


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);
	ALPHA = n_out9p0.x;


}
