render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled;

uniform sampler2D Texture2DParameter : source_color;
uniform vec2 tail_speed;
uniform sampler2D tex_frg_2;



void fragment() {
	vec4 n_out8p0;
// Texture2D:8
	n_out8p0 = texture(Texture2DParameter, UV);
	float n_out8p4 = n_out8p0.a;


// Input:4
